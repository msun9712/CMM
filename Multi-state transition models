# Code 3: Multi-state transition models

library(mstate)
library(survival)

m$deathtime <- ifelse(m$death == 1, m$Time_death, m$Time_follow)
m$fcmd <- ifelse(m$cmm_in == 0, 0, 1)

a <- subset(m, m$fcmd == 1)
a1 <- a[, c("id", "TimetoIHD", "TimetoStro", "TimetoT2DM")]
a1$second_largest <- apply(a1[, -1], 1, function(x) sort(x, decreasing = TRUE)[4])

b <- subset(m, m$fcmd == 0)
b1 <- b[, c("id", "TimetoIHD", "TimetoStro", "TimetoT2DM")]
b1$second_largest <- apply(b1[, -1], 1, function(x) sort(x, decreasing = TRUE)[2])

c <- rbind(a1, b1)
m <- merge(m, c[, c("id", "second_largest")], by = "id")
m$fcmdtime <- ifelse(m$fcmd == 0 & is.na(m$Time_death) == FALSE, m$Time_death, m$second_largest)

m$time <- ifelse(m$outcome == 1 & m$death == 1 & m$time == m$deathtime, m$time - 0.5, m$time)
m$fcmdtime <- ifelse(m$fcmd == 1 & m$death == 1 & (m$fcmdtime == m$deathtime | m$fcmdtime > m$deathtime), m$fcmdtime - 0.5, m$fcmdtime)
m$fcmdtime <- ifelse(m$fcmdtime < 0, 0.1, m$fcmdtime)

m$score.group <- ifelse(m$score >= quantile(m$score, 0.75, na.rm = TRUE), "3",
                        ifelse(m$score >= quantile(m$score, 0.50, na.rm = TRUE), "2",
                               ifelse(m$score >= quantile(m$score, 0.25, na.rm = TRUE), "1", "0")))
m$score.group <- factor(m$score.group)

m$ethnic2[m$ethnic2 == 999] <- NA
m$smoking_staus[m$smoking_staus == 999] <- NA
m$drinking_freq[m$drinking_freq == 999] <- NA
m$perscore <- scale(m$score)

m$sex <- factor(m$sex)
m$ethnic2 <- factor(m$ethnic2)
m$smoking_staus <- factor(m$smoking_staus)
m$drinking_freq <- factor(m$drinking_freq)
m$pa <- factor(m$pa)

m$ptrend <- ifelse(m$score.group == 0, -0.9482843,
                   ifelse(m$score.group == 1, -0.2901189,
                          ifelse(m$score.group == 2, 0.2527658, 0.9711515)))

tmat <- transMat(x = list(c(2, 4), c(3, 4), c(4), c()),
                 names = c("Baseline", "FCMD", "CMM", "Death"))

msebmt <- msprep(data = m, trans = tmat,
                 time = c(NA, "fcmdtime", "time", "deathtime"),
                 status = c(NA, "fcmd", "outcome", "death"),
                 keep = c("age", "sex", "income", "ethnic2", "smoking_staus",
                          "drinking_freq", "pa", "sleep_score2", "dietscore",
                          "bmi", "score.group", "perscore", "ptrend"))

covs <- c("age", "sex", "income", "ethnic2", "smoking_staus", "drinking_freq",
          "pa", "sleep_score2", "dietscore", "bmi", "score.group", "perscore", "ptrend")
msebmt <- expand.covs(msebmt, covs, longnames = FALSE)

cfull_score <- coxph(Surv(Tstart, Tstop, status) ~
                       score.group1.1 + score.group1.2 + score.group1.3 + score.group1.4 + score.group1.5 +
                       score.group2.1 + score.group2.2 + score.group2.3 + score.group2.4 + score.group2.5 +
                       score.group3.1 + score.group3.2 + score.group3.3 + score.group3.4 + score.group3.5 +
                       age.1 + age.2 + age.3 + age.4 + age.5 +
                       sex.1 + sex.2 + sex.3 + sex.4 + sex.5 +
                       income.1 + income.2 + income.3 + income.4 + income.5 +
                       ethnic2.1 + ethnic2.2 + ethnic2.3 + ethnic2.4 + ethnic2.5 +
                       smoking_staus1.1 + smoking_staus1.2 + smoking_staus1.3 + smoking_staus1.4 + smoking_staus1.5 +
                       smoking_staus2.1 + smoking_staus2.2 + smoking_staus2.3 + smoking_staus2.4 + smoking_staus2.5 +
                       smoking_staus3.1 + smoking_staus3.2 + smoking_staus3.3 + smoking_staus3.4 + smoking_staus3.5 +
                       smoking_staus4.1 + smoking_staus4.2 + smoking_staus4.3 + smoking_staus4.4 + smoking_staus4.5 +
                       drinking_freq.1 + drinking_freq.2 + drinking_freq.3 + drinking_freq.4 + drinking_freq.5 +
                       pa.1 + pa.2 + pa.3 + pa.4 + pa.5 +
                       sleep_score2.1 + sleep_score2.2 + sleep_score2.3 + sleep_score2.4 + sleep_score2.5 +
                       dietscore.1 + dietscore.2 + dietscore.3 + dietscore.4 + dietscore.5 +
                       bmi.1 + bmi.2 + bmi.3 + bmi.4 + bmi.5 +
                       strata(trans),
                     data = msebmt, method = "breslow")
summary(cfull_score)

