cmd_vars <- c("IHD_in", "Stro_in", "T2DM_in", "HBP_in", "Heartf_in", "CKD_in")
cmd_times <- c("TimetoIHD", "TimetoStro", "TimetoT2DM", "TimetoHBP", "TimetoHeartf", "TimetoCKD")
cmd_names <- c("IHD", "Stroke", "T2DM", "Hypertension", "HeartFailure", "CKD")

for (j in 1:6) {
  persd$outcome_cmd <- persd[[cmd_vars[j]]]
  persd$time_cmd <- persd[[cmd_times[j]]] / 365.25
  
  res_cmd <- data.frame()
  for (i in 7:255) {
    tryCatch({
      result <- coxph(Surv(time_cmd, outcome_cmd) ~ persd[, i] + age + sex + income + ethnic2 + smoking_staus + drinking_freq + pa + sleep_score2 + dietscore + bmi, data = persd)
      out <- data.frame(cbind(names(persd)[i],
                              t(round(summary(result)$coefficients[1, 2], 2)),
                              t(round(summary(result)$coefficients[1, 1], 2)),
                              t(round(exp(confint(result))[1], 2)),
                              t(round(exp(confint(result))[1, 2], 2)),
                              t(round(summary(result)$coefficients[1, 5], 5))))
    }, error = function(e) { cat("error", conditionMessage(e), "\n\n") },
       warning = function(w) { cat("warning", conditionMessage(w), "\n\n") })
    res_cmd <- rbind(out, res_cmd)
  }
  colnames(res_cmd) <- c("Metabolites.ID", "HR", "beta", "CI1", "CI2", "p")
  res_cmd$fdr <- round(p.adjust(res_cmd$p, method = 'fdr', n = length(res_cmd$p)), 5)
  res_cmd$CI <- paste("(", res_cmd$CI1, ",", res_cmd$CI2, ")", sep = "")
  write.csv(res_cmd, paste0("metabolite_", cmd_names[j], ".csv"), row.names = FALSE)
}

