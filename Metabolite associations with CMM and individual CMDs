# Code 1: Metabolite associations with CMM and individual CMDs

library(survival)
library(caret)

m1 <- train_datam
m1[, 7:255] <- log1p(m1[, 7:255])
persd <- m1
for (i in 7:255) {
  persd[, i] <- scale(persd[, i])
}

res <- data.frame()
for (i in 7:255) {
  tryCatch({
    result <- coxph(Surv(time, outcome) ~ persd[, i] + age + sex, data = persd)
    out <- data.frame(cbind(names(persd)[i],
                            t(round(summary(result)$coefficients[1, 2], 2)),
                            t(round(summary(result)$coefficients[1, 1], 2)),
                            t(round(exp(confint(result))[1], 2)),
                            t(round(exp(confint(result))[1, 2], 2)),
                            t(round(summary(result)$coefficients[1, 5], 5))))
  }, error = function(e) { cat("error", conditionMessage(e), "\n\n") },
     warning = function(w) { cat("warning", conditionMessage(w), "\n\n") })
  res <- rbind(out, res)
}
colnames(res) <- c("Metabolites.ID", "HR", "beta", "CI1", "CI2", "p")
res$fdr <- round(p.adjust(res$p, method = 'fdr', n = length(res$p)), 5)
res$CI <- paste("(", res$CI1, ",", res$CI2, ")", sep = "")

